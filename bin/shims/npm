#!/bin/sh
THIS_DIR="$(cd "$(dirname "$0")" && pwd)"
REAL_NPM=""
OLD_IFS="$IFS"
IFS=":"
for p in $PATH; do
  if [ "$p" != "$THIS_DIR" ] && [ -x "$p/npm" ]; then
    REAL_NPM="$p/npm"
    break
  fi
done
IFS="$OLD_IFS"

if [ -n "$REAL_NPM" ]; then
  exec "$REAL_NPM" "$@"
elif command -v bun >/dev/null 2>&1; then
  exec bun "$@"
else
  echo "[HATA] Sistemde ne npm ne de bun programı bulunamadı." >&2
  exit 1
fi
